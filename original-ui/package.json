{
  "name": "original-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "vite",
    "dev": "vite",
    "build:dev": "run-p type-check build-only:dev",
    "build:prod": "run-p type-check build-only:prod",
    "build:stage": "run-p type-check build-only:stage",
    "build-only:dev": "vite build --mode development",
    "build-only:prod": "vite build --mode production",
    "build-only:stage": "vite build --mode staging",
    "type-check": "vue-tsc --noEmit --skipLibCheck",
    "lint:eslint": "eslint . --ext .js,.ts,.cjs,.cts,.mjs,.mts,.jsx,.tsx,.vue --fix",
    "lint:stylelint": "stylelint --fix \"**/*.{html,vue,css,scss}\" --ignore-path .gitignore",
    "prettier": "prettier --write \"**/*.{js,ts,cjs,cts,mjs,mts,jsx,tsx,html,vue,css,scss,json,md}\" --ignore-path .gitignore",
    "format": "run-p lint:eslint lint:stylelint prettier",
    "preview": "vite preview",
    "sizecheck": "npx vite-bundle-visualizer",
    "commit": "git add -A && git-cz && git push"
  },
  "dependencies": {
    "@date-io/date-fns": "^3.2.1",
    "@tabler/icons-vue": "^3.33.0",
    "@vee-validate/yup": "^4.15.0",
    "@vueuse/core": "^13.2.0",
    "axios": "^1.9.0",
    "date-fns": "^4.1.0",
    "json-bigint": "^1.0.0",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.2",
    "pinia-plugin-persistedstate": "^4.3.0",
    "qs": "^6.14.0",
    "vee-validate": "^4.15.0",
    "vue": "^3.5.14",
    "vue-i18n": "^11.1.3",
    "vue-router": "^4.5.1",
    "vue3-perfect-scrollbar": "^2.0.0",
    "vuetify": "^3.8.11",
    "vuetify-sonner": "^0.3.21",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/compat": "^1.2.9",
    "@eslint/js": "^9.27.0",
    "@iconify-json/tabler": "^1.2.18",
    "@intlify/unplugin-vue-i18n": "^6.0.8",
    "@mdi/font": "^7.4.47",
    "@types/json-bigint": "^1.0.4",
    "@types/node": "^22.15.18",
    "@types/nprogress": "^0.2.3",
    "@types/qs": "^6.14.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitejs/plugin-vue-jsx": "^4.1.2",
    "cz-git": "^1.11.1",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-config-vuetify": "^4.0.0",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-vue": "^10.1.0",
    "globals": "^16.1.0",
    "lint-staged": "^16.0.0",
    "npm-run-all2": "^8.0.2",
    "postcss-html": "^1.8.0",
    "prettier": "^3.5.3",
    "sass-embedded": "^1.89.0",
    "simple-git-hooks": "^2.13.0",
    "stylelint": "^16.19.1",
    "stylelint-config-recess-order": "^6.0.0",
    "stylelint-config-recommended-vue": "^1.6.0",
    "stylelint-config-standard": "^38.0.0",
    "stylelint-config-standard-scss": "^15.0.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.32.1",
    "unplugin-auto-import": "^19.2.0",
    "unplugin-vue-components": "^28.5.0",
    "vite": "^6.3.5",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-vue-devtools": "^7.7.6",
    "vite-plugin-vuetify": "^2.1.1",
    "vue-tsc": "^2.2.10"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  }
}
